# === Wajib ===
TWELVE_DATA_API_KEY=your_key
TELEGRAM_BOT_TOKEN=123456789:AAExample
TELEGRAM_CHAT_ID=-1001234567890

# === Risk ===
ACCOUNT_SIZE_USD=10000
XAUUSD_CONTRACT_SIZE=100        # 100=std, 10=micro, 1=nano — CEK BROKER ANDA
RISK_PCT=1.0
KELLY_FRACTION=0.5
KELLY_CAP_PCT=3.0
MIN_SL_USD=1.0

# === Daily DD protection ===
