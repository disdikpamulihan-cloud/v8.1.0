# === Wajib ===
TWELVE_DATA_API_KEY=your_key
TELEGRAM_BOT_TOKEN=123456789:AAExample
TELEGRAM_CHAT_ID=-1001234567890

# === Mode ===
TRADING_MODE=paper              # paper (auto-confirm) | live (needs confirm.py)

# === Risk ===
ACCOUNT_SIZE_USD=10000
XAUUSD_CONTRACT_SIZE=100        # 100=std, 10=micro, 1=nano — CEK BROKER
RISK_PCT=1.0
KELLY_FRACTION=0.5
KELLY_CAP_PCT=3.0
MIN_SL_USD=1.0

# === Exposure caps (NEW) ===
MAX_CONCURRENT_PER_DIRECTION=2
MAX_TOTAL_OPEN_RISK_PCT=3.0
MAX_DAILY_SIGNALS=10

# === DD protection ===
DAILY_DD_PCT_LIMIT=3.0          # $ drawdown halt
DAILY_DD_LIMIT_R=3.0            # R-sum halt
DAILY_DD_DERISK_R=2.0
DAILY_DD_DERISK_MULT=0.5
CB_HALT_CONSECUTIVE=5
AUTO_CONFIRM_HOURS=4

# === Volatility guard ===
ATR_SPIKE_MULT=1.5
ATR_COLLAPSE_MULT=0.3

# === Macro veto (tuned) ===
MACRO_DXY_VETO_PCT=0.40
MACRO_10Y_VETO_PCT=1.50

# === Supabase (required for LIVE mode) ===
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=signals

# === News ===
NEWS_ENABLED=1
NEWS_CURRENCIES=USD              # USD or USD,EUR,CNY for expanded macro
NEWS_CACHE_TTL_MIN=60

# === Ops ===
TD_QUOTA_WARN_THRESHOLD=100
HEARTBEAT_HOURS=24
ALLOW_UNADJUSTED_PARAMS=0
